
@{
    ViewData["Title"] = "Suppliers";
    Layout = "/Views/Shared/_SimpleLayout.cshtml";

    string[] suppliers =
    {
        "Fresh Food Company",
        "Happy Drinks Company",
        "Daily Supplies Company"
    };
}

<h1>Cafeteria Suppliers</h1>

<p>Our cafeteria works with the following suppliers:</p>

<ul>
    @foreach (string supplier in suppliers)
    {
        <li>@supplier</li>
    }
</ul>

@if (suppliers.Length >= 3)
{
    <p>We have enough suppliers.</p>
}
else
{
    <p>We need more suppliers.</p>
}

<a asp-controller="Cafeteria" asp-action="Index">
    Back to Home
</a>
