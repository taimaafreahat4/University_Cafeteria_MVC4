
@{
    ViewData["Title"] = "Supply Status";
    Layout = null;

    string[] products =
    {
        "Water",
        "Orange Juice",
        "Coffee",
        "Sandwich",
        "Chocolate"
    };

    string[] suppliers =
    {
        "Fresh Food Company",
        "Happy Drinks Company",
        "Daily Supplies Company",
        "Fresh Food Company",
        "Daily Supplies Company"
    };

    int[] quantities = { 100, 20, 50, 0, 30 };

    string[] statuses =
    {
        "Available",
        "Low Stock",
        "Available",
        "Out of Stock",
        "Available"
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Supply Status</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>

<body>
    <div class="container mt-4">

        <h1>Supply Status</h1>

        <p>Current cafeteria supply status:</p>

        <table class="table table-bordered table-striped table-hover">

            <thead class="table-dark">
                <tr>
                    <th>Number</th>
                    <th>Product Name</th>
                    <th>Supplier</th>
                    <th>Quantity</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < products.Length; i++)
                {
                    <tr>
                        <td>@(i + 1)</td>

                        <td>@products[i]</td>

                        <td>@suppliers[i]</td>

                        <td>@quantities[i]</td>

                        

<td>
    @if (statuses[i] == "Available")
    {
        <span class="badge bg-success">
            @statuses[i]
        </span>
    }
    else if (statuses[i] == "Low Stock")
    {
        <span class="badge bg-warning text-dark">
            @statuses[i]
        </span>
    }
    else
    {
        <span class="badge bg-danger">
            @statuses[i]
        </span>
    }
</td>

                    </tr>
                }
            </tbody>

        </table>

        <a class="btn btn-primary"
           asp-controller="Cafeteria"
           asp-action="Index">
            Back to Home
        </a>

    </div>
</body>
</html>
