
<div class="container mt-4">

    <h2>@ViewBag.Title</h2>

    <div class="alert alert-info mt-3">
        Number of Suppliers:
        @ViewBag.NumberOfSuppliers
    </div>

    <div class="row">

        @foreach (string supplier in ViewBag.Suppliers)

        {
            <div class="col-md-4 mb-3">
             @supplier

            </div>
        }

    </div>

</div>
