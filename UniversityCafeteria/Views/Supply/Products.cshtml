@{
    ViewData["PageTitle"] = "Products";
    string[] products = (string[])ViewData["Products"]!;
}

<div class="container mt-4">

    <h2 class="mb-4">@ViewData["Title"]</h2>

    <div class="row mb-4">

        <div class="col-md-6">
            
                    <h5 class="card-title">Manager Name</h5>
                        @ViewData["ManagerName"]
                </div>

        <div class="col-md-6">
            
                    <h5 class="card-title">Number of Products</h5>
                    <p class="card-text">
                        @ViewData["NumberOfProducts"]
                    </p>
                </div>

    </div>
    <h4 class="mb-3">Available Products</h4>
    <div class="row">

        @foreach (string product in products)
        {
            <div class="col-md-4 mb-3">
                
            @product
                       
            </div>
        }

    </div>

</div>
