
<div class="container mt-4">

    <h2>Supply Request Result</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3">
            @ViewBag.Error
        </div>

        <a asp-controller="Supply"
           asp-action="CreateRequest"
           class="btn btn-primary mt-3">
            Back to Request Form
        </a>
    }

</div>
