@model List<UniversityCafeteria.Models.ConfirmedSupplyRequest>

@{
    ViewData["Title"] = "My Requests";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container mt-4">

    <h2>My Supply Requests</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No confirmed requests found.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Request ID</th>
                    <th>Products</th>
                    <th>Subtotal</th>
                    <th>Preparation Fee</th>
                    <th>Discount</th>
                    <th>Final Total</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>@request.RequestID</td>
                        <td>@request.NumberOfProducts</td>
                        <td>@request.Subtotal.ToString("0.00") JD</td>
                        <td>@request.PreparationFee.ToString("0.00") JD</td>
                        <td>@request.Discount.ToString("0.00") JD</td>
                        <td>@request.FinalTotal.ToString("0.00") JD</td>
                        <td>
                            <span class="badge bg-success">
                                @request.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }

    <a href="@Url.Action("Index", "SupplyRequest")"
       class="btn btn-primary">
        Create New Request
    </a>

</div>
