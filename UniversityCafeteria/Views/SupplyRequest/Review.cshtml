@model UniversityCafeteria.Models.SupplyRequestSummary

@{
    ViewData["Title"] = "Review Draft";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container mt-4">

    <h2>Review Supply Request</h2>

    <p>Review your products before confirming the request.</p>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Product</th>
                <th>Category</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Priority</th>
                <th>Total Cost</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Category</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("0.00") JD</td>
                    <td>@item.Priority</td>
                    <td>@((item.Quantity * item.UnitPrice).ToString("0.00")) JD</td>
                </tr>
            }
        </tbody>

    </table>

    <div class="card p-4 mt-4">

        <h4>Request Cost Summary</h4>

        <p>
            <strong>Request Priority:</strong>
            @Model.Priority
        </p>

        <p>
            <strong>Subtotal:</strong>
            @Model.Subtotal.ToString("0.00") JD
        </p>

        <p>
            <strong>Preparation Fee:</strong>
            @Model.PreparationFee.ToString("0.00") JD
        </p>

        <p>
            <strong>Discount:</strong>
            @Model.Discount.ToString("0.00") JD
        </p>

        <hr />

        <h4>
            Final Total: @Model.FinalTotal.ToString("0.00") JD
        </h4>

    </div>

    <div class="mt-4">

        <form method="post"
              action="@Url.Action("ConfirmRequest", "SupplyRequest")"
              class="d-inline">

            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-success">
                Confirm Request
            </button>

        </form>

        <a href="@Url.Action("Index", "SupplyRequest")"
           class="btn btn-secondary">
            Add More Products
        </a>

        <form method="post"
              action="@Url.Action("ClearDraft", "SupplyRequest")"
              class="d-inline">

            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-danger">
                Clear Draft
            </button>

        </form>

    </div>

</div>
