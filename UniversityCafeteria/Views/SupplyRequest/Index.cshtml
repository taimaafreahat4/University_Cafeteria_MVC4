@model UniversityCafeteria.Models.SupplyItem

@{
    ViewData["Title"] = "Create Supply Request";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="container mt-4">

    <h2>Create Supply Request</h2>

    <p>Add products to your supply request.</p>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card p-4 mb-4">

        <h4>Employee Priority Preference</h4>

        <p>
            Your preferred request priority is
            <strong>@ViewBag.PreferredPriority</strong>.
        </p>

        <form method="post"
              action="@Url.Action("SavePreference", "SupplyRequest")">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label>Default Priority</label>

                <select name="priority" class="form-select">
                    <option value="Normal"
                            selected="@(ViewBag.PreferredPriority == "Normal")">
                        Normal
                    </option>

                    <option value="Urgent"
                            selected="@(ViewBag.PreferredPriority == "Urgent")">
                        Urgent
                    </option>

                    <option value="Emergency"
                            selected="@(ViewBag.PreferredPriority == "Emergency")">
                        Emergency
                    </option>
                </select>
            </div>

            <button type="submit" class="btn btn-secondary">
                Save Preference
            </button>
        </form>
    </div>

    <div class="card p-4">

        <h4>Add Product</h4>

        <form method="post"
              action="@Url.Action("AddItem", "SupplyRequest")">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ProductName" class="form-label">
                    Product Name
                </label>

                <input asp-for="ProductName"
                       class="form-control"
                       placeholder="Enter product name" />

                <span asp-validation-for="ProductName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label">
                    Category
                </label>

                <select asp-for="Category" class="form-select">
                    <option value="">Select Category</option>
                    <option value="Drinks">Drinks</option>
                    <option value="Food">Food</option>
                    <option value="Snacks">Snacks</option>
                    <option value="Packaging">Packaging</option>
                    <option value="Other">Other</option>
                </select>

                <span asp-validation-for="Category"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity" class="form-label">
                    Quantity
                </label>

                <input asp-for="Quantity"
                       type="number"
                       min="1"
                       class="form-control" />

                <span asp-validation-for="Quantity"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UnitPrice" class="form-label">
                    Unit Price (JD)
                </label>

                <input asp-for="UnitPrice"
                       type="number"
                       min="0.01"
                       step="0.01"
                       class="form-control" />

                <span asp-validation-for="UnitPrice"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Priority" class="form-label">
                    Priority
                </label>

                <select asp-for="Priority" class="form-select">
                    <option value="Normal">Normal</option>
                    <option value="Urgent">Urgent</option>
                    <option value="Emergency">Emergency</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                Add Product
            </button>

        </form>
    </div>

    <div class="mt-4">
        <h5>Products in Draft: @ViewBag.DraftCount</h5>

        <a href="@Url.Action("Review", "SupplyRequest")"
           class="btn btn-success">
            Review Draft
        </a>

        <form method="post"
              action="@Url.Action("ClearDraft", "SupplyRequest")"
              class="d-inline">

            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-danger">
                Clear Draft
            </button>
        </form>
    </div>

</div>
